# Supabase — required
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key_here

# Recommended for server-side operations (bypasses RLS during pilot)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Server
PORT=3001
# Public URL of your deployment (used by OpenRouter referrer header)
# APP_URL=https://your-app.example.com

# Telegram — can also be connected via Integrations UI (saved to database)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# Admin chat ID for booking notifications and test button (get from @userinfobot)
# TELEGRAM_CHAT_ID=123456789

# Internal cron: POST /api/internal/birthday-owner-notify
# Header: x-cron-secret
# BIRTHDAY_CRON_SECRET=generate-a-long-random-secret

# Apple / calendar connection credential encryption (AES-256-GCM).
# Base64-encoded 32-byte key. Generate outside the app, e.g.:
#   openssl rand -base64 32
# Do not reuse an Apple password. Do not commit the real value.
# Optional at process startup; encrypt/decrypt operations fail closed if missing.
# CALENDAR_CREDENTIALS_ENCRYPTION_KEY=

# WhatsApp credential encryption (AES-256-GCM) — required for WA-2 connect endpoints.
# Base64-encoded 32-byte key used only for encrypting per-salon WhatsApp credentials.
# Generate outside the app, e.g.:
#   openssl rand -base64 32
# Do not put Meta access tokens, app secrets, verify tokens, phone IDs, or WABA IDs here;
# those are per-salon DB credentials in whatsapp_business_connections (never expose to frontend).
# Optional at process startup; missing/invalid key must not crash the server or affect Telegram/Apple.
# WhatsApp connect endpoints fail closed with a safe configuration error if unset.
# WHATSAPP_CREDENTIALS_ENCRYPTION_KEY=

# Instagram credential encryption (AES-256-GCM) — required for IG-2 connect.
# Base64-encoded 32-byte key used only for encrypting per-salon Instagram access tokens.
# Generate outside the app, e.g.:
#   openssl rand -base64 32
# Do not put Meta access tokens or Instagram account IDs here; those belong in
# instagram_business_connections (never expose ciphertext or plaintext to the frontend).
# Optional at process startup; missing/invalid key must not crash the server or affect
# Telegram/Apple/WhatsApp. Connect endpoints fail closed if unset.
# INSTAGRAM_CREDENTIALS_ENCRYPTION_KEY=

# Instagram API with Instagram Login (Business Login) — IG-2 OAuth connect.
# Use Instagram app credentials from Meta App Dashboard (Instagram product), not
# automatically shared with WhatsApp Cloud secrets.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# Exact OAuth redirect URI registered in Meta (must match). Defaults to:
#   ${APP_URL}/api/integrations/instagram/callback
# INSTAGRAM_REDIRECT_URI=

# Instagram Messaging webhook (IG-3) — app-level Meta hub verify token.
# Used only by GET /api/webhooks/instagram. Never expose to frontend.
# POST authenticity uses INSTAGRAM_APP_SECRET + X-Hub-Signature-256 over raw body.
# Do not subscribe messages/messaging_postbacks until a later activation stage.
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Staff portal invite redirect (must be listed in Supabase Auth Redirect URLs)
# Example: https://your-frontend.example.com/set-password
# STAFF_INVITE_REDIRECT_URL=https://your-frontend.example.com/set-password

# AI responses in Telegram bot
# OPENROUTER_API_KEY=sk-or-...
